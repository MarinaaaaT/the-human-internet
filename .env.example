# Publishable — safe to expose to the browser. The actual security boundary
# for anonymous reads is the get_verification_photo() Postgres function
# (security definer, scoped to one photo id) and the storage RLS policy on
# the photos bucket, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=https://xpjkgngifffzdaikjakw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Optional. Sets the canonical origin used for Open Graph metadata.
# Defaults to https://the-human-internet.com if unset.
NEXT_PUBLIC_SITE_URL=https://the-human-internet.com
