{
  "$description": "The Human Internet design tokens. THE single source of truth for web, iOS and Android. Edit values here, then run `node design-system/build.mjs`. Never edit generated files.",

  "color": {
    "primitive": {
      "white":    { "$type": "color", "$value": "#FFFFFF", "$description": "Brand palette: White" },
      "gray-50":  { "$type": "color", "$value": "#F6F6F6", "$description": "Brand palette: Light Gray" },
      "gray-100": { "$type": "color", "$value": "#EFEFEF", "$description": "Observed in scroller UI: pressed/hover fill" },
      "gray-200": { "$type": "color", "$value": "#E6E6E6", "$description": "Hairline borders" },
      "gray-400": { "$type": "color", "$value": "#8F8F8F", "$description": "Scroller secondary text; fails AA under 18px" },
      "gray-600": { "$type": "color", "$value": "#666666", "$description": "AA-safe secondary text" },
      "gray-850": { "$type": "color", "$value": "#161616", "$description": "Dark-mode surface (provisional)" },
      "gray-800": { "$type": "color", "$value": "#1F1F1F", "$description": "Dark-mode hover (provisional)" },
      "gray-750": { "$type": "color", "$value": "#262626", "$description": "Dark-mode border (provisional)" },
      "gray-300": { "$type": "color", "$value": "#A3A3A3", "$description": "Dark-mode muted text (provisional)" },
      "black":    { "$type": "color", "$value": "#000000", "$description": "Brand palette: Black" },
      "sky-300":  { "$type": "color", "$value": "#91CDFF", "$description": "Streak badge, the only chromatic UI color" },
      "red-600":  { "$type": "color", "$value": "#C0281C", "$description": "PROPOSED, not in brand guide: errors" }
    },
    "semantic": {
      "background":            { "$type": "color", "$value": "{color.primitive.white}",    "$extensions": { "dark": "{color.primitive.black}" },    "$description": "Page/screen canvas" },
      "foreground":            { "$type": "color", "$value": "{color.primitive.black}",    "$extensions": { "dark": "{color.primitive.white}" },    "$description": "Primary text, icons, the mark" },
      "surface":               { "$type": "color", "$value": "{color.primitive.gray-50}",  "$extensions": { "dark": "{color.primitive.gray-850}" }, "$description": "Cards, info panels, icon buttons, inputs" },
      "surface-hover":         { "$type": "color", "$value": "{color.primitive.gray-100}", "$extensions": { "dark": "{color.primitive.gray-800}" }, "$description": "Pressed/hover state of surface" },
      "primary":               { "$type": "color", "$value": "{color.primitive.black}",    "$extensions": { "dark": "{color.primitive.white}" },    "$description": "Primary CTA fill" },
      "primary-foreground":    { "$type": "color", "$value": "{color.primitive.white}",    "$extensions": { "dark": "{color.primitive.black}" },    "$description": "Text on primary CTA" },
      "muted-foreground":      { "$type": "color", "$value": "{color.primitive.gray-600}", "$extensions": { "dark": "{color.primitive.gray-300}" }, "$description": "Labels, metadata, timestamps" },
      "subtle-foreground":     { "$type": "color", "$value": "{color.primitive.gray-400}", "$extensions": { "dark": "{color.primitive.gray-400}" }, "$description": "Only for text >= 18px or decorative" },
      "border":                { "$type": "color", "$value": "{color.primitive.gray-200}", "$extensions": { "dark": "{color.primitive.gray-750}" }, "$description": "Hairlines, dividers" },
      "highlight":             { "$type": "color", "$value": "{color.primitive.sky-300}",  "$extensions": { "dark": "{color.primitive.sky-300}" },  "$description": "Count/streak badges ONLY" },
      "highlight-foreground":  { "$type": "color", "$value": "{color.primitive.black}",    "$extensions": { "dark": "{color.primitive.black}" },    "$description": "Text on highlight" },
      "destructive":           { "$type": "color", "$value": "{color.primitive.red-600}",  "$extensions": { "dark": "#FF6B5E" },                    "$description": "Errors, destructive actions (proposed)" },
      "destructive-foreground":{ "$type": "color", "$value": "{color.primitive.white}",    "$extensions": { "dark": "{color.primitive.black}" },    "$description": "Text on destructive" },
      "ring":                  { "$type": "color", "$value": "{color.primitive.black}",    "$extensions": { "dark": "{color.primitive.white}" },    "$description": "Focus ring" }
    }
  },

  "font": {
    "family": {
      "brand":    { "$type": "fontFamily", "$value": "PP Neue Montreal", "$description": "Needs a commercial license for web AND app embedding" },
      "fallback": { "$type": "fontFamily", "$value": "Inter Display",     "$description": "Default until Neue Montreal is licensed" }
    },
    "weight": {
      "medium": { "$type": "fontWeight", "$value": 500, "$description": "The ONLY weight. Hierarchy = size + color." }
    }
  },

  "typography": {
    "$description": "fontSize = web (px). $extensions.mobile.fontSize = iOS pt / Android sp. lineHeight is a multiplier. letterSpacing in em. textStyle = iOS Dynamic Type style it scales with.",
    "display": { "$type": "typography", "$value": { "fontSize": 80, "lineHeight": 0.95, "letterSpacing": -0.045 }, "$extensions": { "mobile": { "fontSize": 44 }, "textStyle": "largeTitle" } },
    "h1":      { "$type": "typography", "$value": { "fontSize": 56, "lineHeight": 1.0,  "letterSpacing": -0.035 }, "$extensions": { "mobile": { "fontSize": 34 }, "textStyle": "largeTitle" } },
    "h2":      { "$type": "typography", "$value": { "fontSize": 40, "lineHeight": 1.05, "letterSpacing": -0.03  }, "$extensions": { "mobile": { "fontSize": 28 }, "textStyle": "title" } },
    "h3":      { "$type": "typography", "$value": { "fontSize": 28, "lineHeight": 1.15, "letterSpacing": -0.02  }, "$extensions": { "mobile": { "fontSize": 22 }, "textStyle": "title2" } },
    "title":   { "$type": "typography", "$value": { "fontSize": 20, "lineHeight": 1.25, "letterSpacing": -0.01  }, "$extensions": { "mobile": { "fontSize": 18 }, "textStyle": "title3" } },
    "body":    { "$type": "typography", "$value": { "fontSize": 16, "lineHeight": 1.45, "letterSpacing": -0.005 }, "$extensions": { "mobile": { "fontSize": 16 }, "textStyle": "body" } },
    "label":   { "$type": "typography", "$value": { "fontSize": 14, "lineHeight": 1.35, "letterSpacing": 0      }, "$extensions": { "mobile": { "fontSize": 14 }, "textStyle": "subheadline" } },
    "caption": { "$type": "typography", "$value": { "fontSize": 12, "lineHeight": 1.35, "letterSpacing": 0.005  }, "$extensions": { "mobile": { "fontSize": 12 }, "textStyle": "caption" } }
  },

  "radius": {
    "sm":   { "$type": "dimension", "$value": 8,    "$description": "Chips, thumbnails" },
    "md":   { "$type": "dimension", "$value": 12,   "$description": "Info cards, inputs" },
    "lg":   { "$type": "dimension", "$value": 16,   "$description": "Cards, notification cards, photos" },
    "xl":   { "$type": "dimension", "$value": 24,   "$description": "Sheets, large photo frames" },
    "2xl":  { "$type": "dimension", "$value": 40,   "$description": "Hero photos, selfie 'pebble' frame" },
    "full": { "$type": "dimension", "$value": 9999, "$description": "Pills and circles (all buttons)" }
  },

  "spacing": {
    "1":  { "$type": "dimension", "$value": 4 },
    "2":  { "$type": "dimension", "$value": 8 },
    "3":  { "$type": "dimension", "$value": 12 },
    "4":  { "$type": "dimension", "$value": 16 },
    "6":  { "$type": "dimension", "$value": 24 },
    "8":  { "$type": "dimension", "$value": 32 },
    "12": { "$type": "dimension", "$value": 48 },
    "16": { "$type": "dimension", "$value": 64 },
    "24": { "$type": "dimension", "$value": 96 }
  },

  "size": {
    "control-height": { "$type": "dimension", "$value": 48, "$description": "Buttons, inputs" },
    "icon-button":    { "$type": "dimension", "$value": 48, "$description": "Circular icon button" },
    "min-touch":      { "$type": "dimension", "$value": 44, "$description": "Minimum tap target (Android: use 48dp)" },
    "icon":           { "$type": "dimension", "$value": 22, "$description": "Default icon size" },
    "thumbnail":      { "$type": "dimension", "$value": 64, "$description": "Notification thumbnail" }
  },

  "shadow": {
    "float": { "$type": "shadow", "$value": { "offsetX": 0, "offsetY": 24, "blur": 64, "spread": -16, "color": "#000000", "opacity": 0.18 }, "$description": "ONLY floating layers: sheets, popovers, dialogs. Cards are flat." }
  },

  "motion": {
    "duration": {
      "fast":  { "$type": "duration", "$value": 150, "$description": "Press, toggle (proposed)" },
      "base":  { "$type": "duration", "$value": 300, "$description": "Hover/tap reveal, crossfade (measured ~270-300ms)" },
      "slow":  { "$type": "duration", "$value": 750, "$description": "Brand reveals (measured ~730-770ms)" },
      "stagger": { "$type": "duration", "$value": 800, "$description": "Delay between items in a brand reveal" },
      "boil":  { "$type": "duration", "$value": 120, "$description": "Hand-drawn boil frame interval of the mark (~8fps)" }
    },
    "easing": {
      "out":    { "$type": "cubicBezier", "$value": [0.3, 0.7, 0.4, 1],  "$description": "Gentle decelerate, no overshoot" },
      "in-out": { "$type": "cubicBezier", "$value": [0.65, 0, 0.35, 1], "$description": "Wipes/exits" }
    }
  }
}
